        "note": "Names and references only, never values — this artifact is what every later step depends on."
      },
      {
        "id": "decide",
        "label": "Per-secret decision",
        "focus": [
          "decide",
          "not_migrated"
        ],
        "note": "A cloud credential for the source cloud has no place in the target; an unknown origin stops cutover, not the other way around."
      },
      {
        "id": "recreate",
        "label": "Recreate and sequence",
        "focus": [
          "create_scope",
          "grant_acl",
          "cutover"
        ],
        "note": "A scope with values but no ACL fails silently at job run time, not at deploy time."
      }
    ]
  },
  "lanes": [
    {
      "id": "discover",
      "label": "Build the map"
    },
    {
      "id": "decide",
      "label": "Decide per secret"
    },
