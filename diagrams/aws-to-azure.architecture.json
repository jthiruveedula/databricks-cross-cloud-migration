  "cards": [
    {
      "dot": "cyan",
      "title": "Move as code, not by hand",
      "items": [
        "Terraform provider defines workspaces, pools, policies and metastore",
        "Databricks Asset Bundles carry jobs, notebooks and pipelines",
        "Instance profiles become Azure-native identities"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data and catalog",
      "items": [
        "AzCopy / Storage Mover does the bulk pass, then incremental deltas",
        "DEEP CLONE rebuilds managed Delta tables on ADLS Gen2 with history",
        "External locations and grants are replayed, never recreated by hand"
      ]
    },
    {
      "dot": "amber",
      "title": "Cutover safety",
      "items": [
        "AWS workspace goes read-only before the final incremental pass",
        "Row counts, checksums and MLflow model versions are diffed",
        "Event bridge keeps both clouds fed until target consumers are verified"
      ]
    }
  ]
