  "cards": [
    {
      "dot": "cyan",
      "title": "Producers do not move first",
      "items": [
        "Azure producers keep writing to Event Hubs during the whole migration",
        "The relay is the only new Azure component and it is disposable",
        "Ordering key preserves per-partition order across the bridge"
      ]
    },
    {
      "dot": "amber",
      "title": "Delivery is at-least-once",
      "items": [
        "Pub/Sub redelivers whenever the ack deadline passes",
        "The streaming job acks only after the Delta commit",
        "Checkpoints live on GCS and are never copied from Azure"
      ]
    },
    {
      "dot": "emerald",
      "title": "Effectively-once landing",
      "items": [
        "MERGE on event id makes redelivery harmless",
        "Delta commit version is the durable record, not the ack",
        "Cutover removes the relay, producers repoint to Pub/Sub directly"
      ]
    }
  ]
