  "flows": [
    {
      "id": "objects",
      "from": "adls",
      "to": "sts",
      "label": "read files",
      "classification": "bulk",
      "variant": "emphasis"
    },
    {
      "id": "copy",
      "from": "sts",
      "to": "gcs",
      "label": "copy",
      "classification": "verified",
      "variant": "emphasis"
    },
    {
      "id": "register",
      "from": "gcs",
      "to": "clone",
      "label": "register",
      "classification": "path",
      "variant": "default"
    },
    {
      "id": "ddl",
      "from": "hms",
      "to": "ucx",
      "label": "table DDL",
      "classification": "metadata",
      "variant": "default"
    },
    {
      "id": "replay",
      "from": "ucx",
      "to": "uc",
      "label": "recreate",
      "classification": "grants",
      "variant": "security"
    },
    {
      "id": "capture",
      "from": "evhub",
      "to": "bridge",
      "label": "capture",
      "classification": "ordered",
      "variant": "default"
    },
    {
      "id": "publish",
      "from": "bridge",
      "to": "pubsub",
      "label": "publish",
      "classification": "dual-write",
      "variant": "emphasis"
    },
    {
      "id": "subscribe",
      "from": "pubsub",
      "to": "streaming",
      "label": "subscribe",
      "classification": "at-least-once",
      "variant": "emphasis"
    },
    {
      "id": "curated",
      "from": "clone",
      "to": "consumers",
      "label": "curated",
      "classification": "reconciled",
      "variant": "emphasis"
    },
    {
      "id": "appends",
      "from": "streaming",
      "to": "consumers",
      "label": "appends",
      "classification": "incremental",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Two clocks, one cutover",
      "items": [
        "Bulk copy runs for days while Azure stays writable",
        "Final incremental pass runs only after Azure goes read-only",
        "Streaming checkpoints are rebuilt, never copied across clouds"
      ]
    },
    {
      "dot": "emerald",
      "title": "What DEEP CLONE buys",
      "items": [
        "Delta history and time travel survive the move",
        "Managed tables land under Unity Catalog on GCS",
        "OPTIMIZE and Z-ORDER are re-run because file layout does not transfer"
      ]
    },
    {
      "dot": "amber",
      "title": "Reconciliation gate",
      "items": [
        "Row counts and column checksums diffed per table",
        "Grants compared against the exported Azure ACL set",
        "A table is released to consumers only after its diff is empty"
      ]
    }
  ]
}