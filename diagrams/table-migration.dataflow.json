      "row": 0,
      "tag": "copy",
      "width": 132,
      "height": 64
    },
    {
      "id": "ucx",
      "type": "backend",
      "label": "UCX export",
      "sublabel": "DDL + grants",
      "stage": 1,
      "row": 1,
      "tag": "assess",
      "width": 132,
      "height": 64
    },
    {
      "id": "bridge",
      "type": "messagebus",
      "label": "Event bridge",
