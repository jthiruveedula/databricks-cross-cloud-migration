{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Table and Event Migration Pipeline: ADLS Gen2 to GCS Lakehouse",
    "output": "table-migration.dataflow.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "file-path",
        "label": "File path",
        "focus": [
          "adls",
          "sts",
          "gcs",
          "clone"
        ],
        "note": "Delta files and transaction logs move by bulk copy, then incremental catch-up."
      },
      {
        "id": "catalog-path",
        "label": "Catalog path",
        "focus": [
          "hms",
          "ucx",
          "uc"
        ],
        "note": "Schemas, tables, views and grants are exported and replayed onto Unity Catalog."
      },
      {
        "id": "event-path",
        "label": "Event path",
        "focus": [
          "evhub",
          "bridge",
          "pubsub",
          "streaming"
        ],
        "note": "Azure event traffic is bridged to Pub/Sub and consumed by Structured Streaming."
      }
    ],
    "viewBox": [
      1080,
      500
    ],
    "animation": "trace"
  },
  "stages": [
    {
      "label": "Azure source"
    },
    {
      "label": "Transfer"
    },
    {
      "label": "Land on GCP"
    },
    {
      "label": "Rebuild"
    },
    {
      "label": "Consume"
    }
  ],
