  "cards": [
    {
      "dot": "cyan",
      "title": "A limit, not a preference",
      "items": [
        "Databricks is explicit: only one metastore per region, per account",
        "The account sits above every cloud subscription in the tenant, so separate subscriptions don't buy separate metastores",
        "Cross-cloud migration always means a new metastore in the target account and region"
      ]
    },
    {
      "dot": "amber",
      "title": "Isolation is catalogs, not metastores",
      "items": [
        "Every team landing in a region shares the same metastore and catalog namespace",
        "Catalog naming is an account-wide decision made before the first migration, not a per-team one",
        "See metastore migration for the collision this causes when a second team arrives"
      ]
    },
    {
      "dot": "rose",
      "title": "Identity is centralized above the metastore",
      "items": [
        "Unity Catalog identity lives at the account level, above any single workspace",
        "Convert workspace-local groups to account-level groups before attaching to the target metastore",
        "Skipping this breaks grants and duplicates group names in every workspace that attaches"
      ]
    }
  ]
